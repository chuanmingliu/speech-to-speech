# Copy to .env.local, add your own credentials, and never commit .env.local.
# This template intentionally contains names and non-secret defaults only.

DEEPSEEK_API_KEY=

TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
