{
  "mode": "realtime",
  "ws_host": "0.0.0.0",
  "ws_port": 8765,
  "stt": "tencent",
  "enable_live_transcription": true,
  "live_transcription_update_interval": 0.2,
  "llm_backend": "chat-completions",
  "model_name": "deepseek-v4-flash",
  "responses_api_base_url": "https://api.deepseek.com",
  "responses_api_stream": true,
  "responses_api_disable_thinking": true,
  "responses_api_connection_keepalive_s": 300,
  "responses_api_prewarm_wait_s": 0.5,
  "chat_size": 8,
  "compact_history": false,
  "stream_batch_sentences": 1,
  "stream_first_chunk_lookahead_chars": 3,
  "request_hedge_after_ms": 2000,
  "speculative_reopen_ms": 250,
  "speech_pad_ms": 80,
  "tts": "minimax",
  "minimax_tts_speed": 1.3,
  "minimax_tts_prime_texts": "好的，|没问题，|好的。|嗯，|我帮你查一下，",
  "num_pipelines": 1,
  "log_level": "info"
}
