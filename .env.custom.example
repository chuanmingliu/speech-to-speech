# Copy to .env.local, fill in fresh credentials, and never commit that local file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_APP_ID=
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_LANGUAGE=zh
TENCENT_ASR_OPEN_TIMEOUT_S=1.5

MINIMAX_TTS_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_SPEED=1.2
MINIMAX_TTS_LANGUAGE_BOOST=auto
MINIMAX_TTS_STREAM=true
MINIMAX_TTS_WARMUP=true
MINIMAX_TTS_MODEL_WARMUP=true
# Hidden text used to warm the model. Set this to a common greeting to precache it.
MINIMAX_TTS_MODEL_WARMUP_TEXT=Hi.
MINIMAX_TTS_CONNECTION_KEEPALIVE_S=300
MINIMAX_TTS_CACHE_MAX_MB=32
# Streaming uses the persistent WebSocket endpoint. The HTTP endpoint is kept
# only for MINIMAX_TTS_STREAM=false and the voice-list fallback.
# Replace api.minimaxi.com with api.minimax.io for global-platform keys.
MINIMAX_TTS_WEBSOCKET_ENDPOINT=wss://api.minimaxi.com/ws/v1/t2a_v2_bidi
MINIMAX_TTS_WEBSOCKET_OPEN_TIMEOUT_S=5
MINIMAX_TTS_WEBSOCKET_RECEIVE_TIMEOUT_S=30
MINIMAX_TTS_WEBSOCKET_MAX_IDLE_S=90
MINIMAX_TTS_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2

# Keep idle telephony pool lanes connected before call admission. Set to 0 to disable.
PROVIDER_CONNECTION_MAINTENANCE_S=30
