# API-only cascade (Tencent ASR + DeepSeek + MiniMax). No GPU required.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/src/app/.venv/bin:${PATH}" \
    S2S_PROFILE=/usr/src/app/configs/tencent-deepseek-minimax.json

WORKDIR /usr/src/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

COPY pyproject.toml README.md LICENSE MANIFEST.in ./
RUN uv sync --python /usr/bin/python3 --no-install-project --no-dev --extra tencent-asr

COPY . .
RUN uv sync --python /usr/bin/python3 --no-dev --extra tencent-asr \
    && python -c "import nltk; nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger_eng')"

EXPOSE 8765

COPY scripts/docker_entrypoint_custom.sh /usr/local/bin/docker_entrypoint_custom.sh
RUN chmod +x /usr/local/bin/docker_entrypoint_custom.sh

ENTRYPOINT ["/usr/local/bin/docker_entrypoint_custom.sh"]
CMD ["speech-to-speech", "configs/tencent-deepseek-minimax.json"]
